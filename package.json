{
  "name": "schoolflow",
  "productName": "schoolFlow",
  "version": "1.0.0",
  "description": "School management desktop application",
  "main": "./out/main/index.js",
  "author": {
    "name": "Taki",
    "email": "takibou532@example.com"
  },
  "homepage": "https://github.com/takibou532-png/SchoolFlow",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "electron-vite dev",

    "build": "electron-vite build && shx rm -rf out/main/db/migrations && shx mkdir -p out/main/db && shx cp -r src/main/db/migrations out/main/db/",

    "start": "electron-vite preview",

    "clean:userdata": "node scripts/clean-userdata.js",

    "dist": "npm run clean:userdata && electron-builder",

    "dist:win": "npm run clean:userdata && electron-builder --win",

    "dist:win:ia32": "npm run clean:userdata && electron-builder --win --ia32",

    "dist:win:x64": "npm run clean:userdata && electron-builder --win --x64",

    "dist:mac": "npm run clean:userdata && electron-builder --mac",

    "dist:mac:x64": "npm run clean:userdata && electron-builder --mac --x64",

    "dist:mac:arm64": "npm run clean:userdata && electron-builder --mac --arm64",

    "dist:linux": "npm run build && electron-builder --linux",

    "db:reset": "node scripts/reset-db.js",

    "db:generate": "drizzle-kit generate",

    "db:push": "drizzle-kit push",

    "db:studio": "drizzle-kit studio"
  },

  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.12.0",
    "@mui/x-date-pickers": "^9.12.0",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.38.4",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },

  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.1",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },

  "build": {
    "appId": "com.schoolflow.desktop",
    "productName": "schoolFlow",

    "directories": {
      "output": "release"
    },

    "files": [
      "out/**/*",
      "package.json"
    ],

    "extraResources": [
      {
        "from": "src/main/db/migrations",
        "to": "migrations"
      }
    ],

    "asar": true,

    "npmRebuild": true,

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signingHashAlgorithms": null,
      "sign": null
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "schoolFlow",
      "uninstallDisplayName": "schoolFlow",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },

    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },

    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },

    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },

    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "takibou532@example.com"
    },

    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },

    "deb": {
      "artifactName": "${productName}-${version}-${arch}.deb"
    }
  },

  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@33.3.1": true
  }
}